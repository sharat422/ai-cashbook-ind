# Android release signing — COPY to `android/keystore.properties` and fill in.
# NEVER commit the real file or the .keystore/.jks (both are gitignored).
#
# 1. Generate an upload key (do this ONCE; keep the .jks + passwords safe —
#    losing them means you can't ship updates unless enrolled in Play App Signing):
#
#      keytool -genkeypair -v \
#        -storetype JKS \
#        -keystore smartcashbook-upload.jks \
#        -alias smartcashbook-upload \
#        -keyalg RSA -keysize 2048 -validity 10000
#
# 2. Put smartcashbook-upload.jks in android/app/ (or an absolute path below).
# 3. Fill these in. RELEASE_STORE_FILE is resolved relative to android/app/.
# 4. In CI (Codemagic), inject these four values from encrypted env vars and
#    write this file at build time — do not store it in the repo.

RELEASE_STORE_FILE=smartcashbook-upload.jks
RELEASE_STORE_PASSWORD=CHANGE_ME
RELEASE_KEY_ALIAS=smartcashbook-upload
RELEASE_KEY_PASSWORD=CHANGE_ME
