<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Smart CashBook</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleIconName</key>
    <string>AppIcon</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
	  <!-- Do not change NSAllowsArbitraryLoads to true, or you will risk app rejection! -->	    
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<!--
		  Certificate pinning (scaffold — DISABLED until real pins are filled).
		  To enable, UNCOMMENT the NSPinnedDomains block below and replace BOTH
		  placeholder digests with real base64 SHA-256 SPKI pins. Ship at least
		  two (primary + backup). See docs/CERTIFICATE_PINNING.md — especially the
		  Let's-Encrypt rotation strategy, so a Render cert renewal can't brick
		  the shipped app. DO NOT ship placeholder values: wrong pins block ALL
		  API traffic. (NSPinnedDomains requires iOS 14+.)

		<key>NSPinnedDomains</key>
		<dict>
			<key>YOUR-API-HOST.onrender.com</key>
			<dict>
				<key>NSIncludesSubdomains</key>
				<true/>
				<key>NSPinnedCAIdentities</key>
				<array>
					<dict>
						<key>SPKI-SHA256-BASE64</key>
						<string>PLACEHOLDER_PRIMARY_SPKI_SHA256_BASE64=</string>
					</dict>
					<dict>
						<key>SPKI-SHA256-BASE64</key>
						<string>PLACEHOLDER_BACKUP_SPKI_SHA256_BASE64=</string>
					</dict>
				</array>
			</dict>
		</dict>
		-->
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Smart CashBook needs camera access to scan receipts and attach photos to your transactions.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Smart CashBook uses the microphone so you can speak a transaction in your language and we turn it into an entry.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Smart CashBook needs photo library access to attach receipts and images to your transactions.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Smart CashBook needs permission to save generated statements to your photo library.</string>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
</dict>
</plist>
